{
    "name": "shelfwood/health",
    "description": "Laravel application health checks with a stable JSON contract for external monitoring",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "health", "monitoring", "diagnostics"],
    "authors": [
        {
            "name": "Shelfwood",
            "email": "packages@shelfwood.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Shelfwood\\Health\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shelfwood\\Health\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shelfwood\\Health\\HealthServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
